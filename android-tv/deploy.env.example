# Copie para deploy.env. O deploy.env fica fora do git e da Vercel.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# Link público do bucket, com https.
R2_PUBLIC_URL=
# Se ficarem vazias, o deploy.sh pede na tela e salva aqui.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
